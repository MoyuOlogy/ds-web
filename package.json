{
  "name": "ds-web",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "ds-web: a DeepSeek-web-style chat panel for DeepSeek Harness, with streaming chat, thinking, web search, file parsing, OCR and DeepSeek export import.",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "chat",
    "ocr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoyuOlogy/ds-web.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}